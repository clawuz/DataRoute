rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /public/day.json {
      allow read: if true;
    }
    // daily track (written by the daily-music pipeline with the Admin SDK; the site reads the pointer and the files)
    match /public/music/{allPaths=**} {
      allow read: if true;
    }
    // AI versions of personal pieces (written by the composePersonal function with the Admin SDK)
    match /public/personal/{file} {
      allow read: if true;
    }
  }
}
